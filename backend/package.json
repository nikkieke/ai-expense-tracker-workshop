{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "tsx src/test/receipt.validator.test.ts && tsx src/test/resilience.test.ts && tsx src/test/get-expenses.test.ts",
    "genkit:dev": "genkit start -- tsx --watch src/index.ts",
    "eval": "tsx evaluations/eval.ts",
    "eval:low-prompt": "tsx evaluations/eval.ts --prompt low",
    "eval:compare-prompts": "tsx evaluations/eval.ts --compare-prompts",
    "eval:compare-models": "tsx evaluations/eval.ts --compare-models"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Genkit AI Backend for Expense Tracker",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.42.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "genkit": "^1.42.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
